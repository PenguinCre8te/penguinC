#import std.console;

int main() {
    array<int> arr = [10, 20, 30];
    console.println_int(arr[0]);
    console.println_int(arr[1]);
    console.println_int(arr[2]);

    arr[1] = 99;
    console.println_int(arr[1]);

    for item in [1, 2, 3, 4, 5] {
        console.println_int(item);
    }

    array<int> nums = [100, 200, 300];
    for n in nums {
        console.println_int(n);
    }

    return 0;
}
