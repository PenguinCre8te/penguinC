#import std.console;

int main() {
    i8 a = 10;
    console.println_int(a.to<int>());

    i16 b = 2000;
    console.println_int(b.to<int>());

    i32 c = 100000;
    console.println_int(c.to<int>());

    i64 d = 9999999;
    console.println_int(d.to<int>());

    u8 e = 255;
    console.println_int(e.to<int>());

    u16 f = 65000;
    console.println_int(f.to<int>());

    usize h = 42;
    console.println_int(h.to<int>());

    f32 pi32 = 3.14;
    string sp = pi32.to<string>();
    console.println(sp);

    f64 pi64 = 3.14159265;
    string sp2 = pi64.to<string>();
    console.println(sp2);

    return 0;
}
