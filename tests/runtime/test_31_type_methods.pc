#import std.console;

int main() {
    int x = 42;
    float pi = 3.14;
    string s = "100";
    int b = 1;

    string sx = x.to<string>();
    console.println(sx);

    int si = s.to<int>();
    console.println_int(si);

    string fx = x.to<float>().to<string>();
    console.println(fx);

    string sp = pi.to<string>();
    console.println(sp);

    string sb = b.to<bool>().to<string>();
    console.println(sb);

    return 0;
}
