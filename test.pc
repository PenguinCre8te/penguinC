#import std.console;
#import std.threads;
#import std.mutex;
shared mut long counter = 0

long increment(mutex m) {
    for i in 0..1000000 {
        using(m) {
            counter = counter + 1
        }
    }
    return 0
}

int main() {
    using(mutex.create() as m) {
        threads.Thread t1 = threads.run(increment, m)
        threads.Thread t2 = threads.run(increment, m)
        threads.Thread t3 = threads.run(increment, m)
        t1.get()
        t2.get()
        t3.get()
    }
    console.println(counter)
    return 0;
}
